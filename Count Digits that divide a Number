import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Entere an Integer: ");
        int num = scanner.nextInt();

        int result = 0;
        int ognum = num;

        while (num != 0) {
            int dig = num % 10;

            if (ognum % dig == 0) {
                result++;
            }

            num = num / 10;
        }

        System.out.println("number of digits in num that divide num are: " + result);
    }
}
